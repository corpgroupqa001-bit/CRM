# ---- Supabase (Project settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://abagfvvnjpazrfeblnqg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
NEXT_PUBLIC_APP_NAME=corpgroup.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# random secret mixed into OTP hashes:  openssl rand -hex 32
OTP_PEPPER=
# 32-byte key for PAN / Aadhaar / bank column encryption:  openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# Email verification: "on" = sign-up / activation / reset need an emailed code or link.
# "off" = accounts are created and activated with a password, no verification email.

# ---- Email (Nodemailer over SMTP). Leave SMTP_HOST empty in development: OTPs are printed to the server console ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="corpgroup.com <no-reply@corpgroup.com>"

# ---- Web push (COMMS-07):  npx web-push generate-vapid-keys ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@corpgroup.com
# shared secret for the Supabase database webhook that calls /api/push/dispatch
PUSH_WEBHOOK_SECRET=
# secret for scheduled jobs (/api/cron/*), sent as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Google sign-in (AUTH-16): set to "on" after enabling the Google provider in Supabase Auth
NEXT_PUBLIC_GOOGLE_AUTH=off
# signs the 'company unlocked' cookie (password again when switching company); defaults to OTP_PEPPER
COMPANY_LOCK_SECRET=
# Addresses of this app that each keep their own sign-in, so two accounts can be signed in at once in one
# browser (one per address). Unset in development = http://localhost:3000,http://127.0.0.1:3000.
# Production: list two domains pointing at the same deployment, e.g. https://app.example.com,https://app2.example.com
NEXT_PUBLIC_SESSION_ORIGINS=
